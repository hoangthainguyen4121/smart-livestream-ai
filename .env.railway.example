# Railway deployment — copy values after creating services in Railway dashboard.
# Do NOT commit real production secrets.

# ========== BACKEND SERVICE ==========
# Railway auto-injects PORT — do not set manually.

# Required after frontend is deployed (exact public HTTPS origin):
CORS_ORIGINS=https://YOUR-FRONTEND.up.railway.app

# Optional — PhoBERT on Hugging Face Spaces (free 16 GB CPU):
# ML_INTENT_API_URL=https://YOUR-HF-USERNAME-livestream-intent.hf.space
ML_INTENT_TIMEOUT_SECONDS=60

# Camera product recognition (legacy dHash full-frame). Superseded by hand-held vision when enabled.
VITE_ENABLE_CAMERA_PRODUCT_RECOGNITION=false
CAMERA_PRODUCT_RECOGNITION_ENABLED=false

# Hand-held vision — backend indexes catalog embeddings; frontend gates on MediaPipe hand detection.
VITE_ENABLE_HAND_HELD_VISION=false
HAND_HELD_VISION_ENABLED=false
# Optional CLIP encoder: pip install -r backend/requirements-vision.txt (local/heavier deploy only)

# Supabase Postgres (backend only — never expose to frontend build):
# Required only when CHAT_PERSISTENCE_MODE=short_retention
# DATABASE_URL=postgresql+psycopg://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres

# Chat persistence (default memory — no DB required for realtime chat):
CHAT_PERSISTENCE_MODE=memory
CHAT_RETENTION_HOURS=24
COMMENT_PERSIST_TIMEOUT_SECONDS=3.0

# ========== FEEDBACK / EXPORT / RETRAIN (backend runtime) ==========
# Required for intent corrections, admin review, export batches, ML retrain worker API.
# Use Railway PostgreSQL plugin OR Supabase pooler URL (postgresql+psycopg://...).
# DATABASE_URL=postgresql+psycopg://postgres:password@HOST:5432/railway

# Admin review (server secret — never bake into frontend build):
# ADMIN_API_KEY=generate-a-long-random-string

# Internal ML retrain worker (GitHub Actions cron uses this header):
# ML_RETRAIN_WORKER_API_KEY=generate-a-different-long-random-string
# ML_RETRAIN_STALE_CLAIM_MINUTES=120
# ML_RETRAIN_MAX_CANDIDATE_BATCHES=50

# Immutable export artifacts — MUST survive redeploy (Railway Volume mount):
# 1. Backend service → Volumes → mount e.g. /data
# 2. Set:
DATASET_EXPORT_DIR=/data/dataset_exports
# MAX_DATASET_EXPORT_RECORDS=1000

# ========== FRONTEND SERVICE (build-time variables) ==========
# In Railway: Variables → enable "Available at Build" for both.

# Backend public HTTPS URL (no trailing slash):
VITE_API_BASE_URL=https://YOUR-BACKEND.up.railway.app

# WebSocket base (wss). Usually same host as API:
VITE_WS_BASE_URL=wss://YOUR-BACKEND.up.railway.app

# If VITE_WS_BASE_URL is omitted, frontend derives wss:// from VITE_API_BASE_URL automatically.

# Optional login — Supabase Auth + Google OAuth (enable "Available at Build"):
# Google Client ID/Secret: Supabase Dashboard → Authentication → Providers → Google (not Railway env).
# Supabase → Authentication → URL Configuration must include production frontend:
#   Site URL: https://YOUR-FRONTEND.up.railway.app
#   Redirect URLs: https://YOUR-FRONTEND.up.railway.app/** (+ keep localhost for dev)
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-public-key

# Admin page MVP: do NOT set VITE_ADMIN_API_KEY in public production builds.
# Open https://YOUR-FRONTEND.up.railway.app/#/admin/intent-corrections and paste ADMIN_API_KEY
# into the unlock form (stored in sessionStorage for the browser session only).
