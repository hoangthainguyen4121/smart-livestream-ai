# Backend environment (local dev / Railway backend service)

# Default realtime chat path — no PostgreSQL required.
CHAT_PERSISTENCE_MODE=memory

# Host presence lease: auto-end room after host stops heartbeating (seconds).
# HOST_LEASE_GRACE_SECONDS=180

# Feedback DB (F1 intent corrections) — required for POST /api/intent-corrections
# Works independently of CHAT_PERSISTENCE_MODE when set to memory.
# Local options (pick one):
#   A) Windows Postgres service already running on :5432
#   B) docker compose -f docker-compose.postgres.yml up -d
# Then:
# DATABASE_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:5432/smart_livestream_local
# Migrate from backend/: alembic upgrade head
#
# Pytest ONLY — never point this at the demo/runtime DB above:
# TEST_DATABASE_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:5432/smart_livestream_test
# Destructive fixtures refuse smart_livestream_local and any DB name without "test".

# Admin review guard (config-based MVP — not full RBAC):
ADMIN_API_KEY=local-dev-admin-key

# Immutable export artifacts (approved corrections only):
# DATASET_EXPORT_DIR=dataset_exports
# MAX_DATASET_EXPORT_RECORDS=1000

# ML retrain worker (internal cron API — separate from admin key):
# ML_RETRAIN_WORKER_API_KEY=local-dev-ml-retrain-worker-key
# ML_RETRAIN_STALE_CLAIM_MINUTES=120

# Policy boundary for short_retention rows (deletion job not implemented in P0c):
CHAT_RETENTION_HOURS=24

# WebSocket persist timeout when short_retention is enabled:
COMMENT_PERSIST_TIMEOUT_SECONDS=3.0

# Adult/NSFW frame-gate (optional — requires: pip install -r requirements-nsfw.txt)
# Local Falconsai/nsfw_image_detection only. No HF Inference API. No image persistence.
NSFW_FRAME_GATE_ENABLED=false
NSFW_MODEL_ID=Falconsai/nsfw_image_detection
NSFW_MODEL_REVISION=04367978d3474804ab1a00a9bd6548b741764069
# REQUIRED outside project, e.g. C:\Users\YOU\.cache\smart-livestream-nsfw
# NSFW_MODEL_CACHE_DIR=
NSFW_MIN_SCORE=0.70
# NSFW_LOCAL_FILES_ONLY=false

# Suggestive multi-class (viddexa/nsfw-detection-2-nano, Apache-2.0). Complements Falconsai.
# Start-LocalDemo.ps1 forces true in the child process only.
SUGGESTIVE_CLASSIFIER_ENABLED=false
SUGGESTIVE_MODEL_ID=viddexa/nsfw-detection-2-nano
SUGGESTIVE_MODEL_REVISION=12e57200346246b37382f746e4d94d10b014f6a1
# REQUIRED outside project, e.g. C:\Users\YOU\.cache\smart-livestream-suggestive
# SUGGESTIVE_MODEL_CACHE_DIR=
SUGGESTIVE_MIN_SCORE=0.35
# SUGGESTIVE_LOCAL_FILES_ONLY=false

# Weapon/gun open-vocab detector (optional — pip install -r requirements-weapon.txt)
# Local IDEA-Research/grounding-dino-tiny only. Warning-only; no auto session close.
WEAPON_DETECTOR_ENABLED=false
WEAPON_MODEL_ID=IDEA-Research/grounding-dino-tiny
WEAPON_MODEL_REVISION=a2bb814dd30d776dcf7e30523b00659f4f141c71
# REQUIRED outside project, e.g. C:\Users\YOU\.cache\smart-livestream-weapon
# WEAPON_MODEL_CACHE_DIR=
WEAPON_BOX_THRESHOLD=0.42
WEAPON_TEXT_THRESHOLD=0.30
WEAPON_MAX_EDGE=640
# WEAPON_TEXT_PROMPT=gun. pistol. rifle. firearm. handgun. shotgun. assault rifle. submachine gun. knife. scissors.
# WEAPON_LOCAL_FILES_ONLY=false

# Firearm ONNX — Subh775/Firearm_Detection_Yolov8n → onnxruntime (MVP primary when enabled).
# Does NOT replace Grounding DINO (fallback). Inference does not import ultralytics.
# Prepare once: python scripts/export_firearm_onnx.py
# Production default MUST stay false (AGPL lineage). Start-LocalDemo forces true in child only.
FIREARM_ONNX_ENABLED=false
FIREARM_ONNX_HF_REPO=Subh775/Firearm_Detection_Yolov8n
# REQUIRED outside project, e.g. C:\Users\YOU\.cache\smart-livestream-firearm-onnx
# FIREARM_ONNX_CACHE_DIR=
# FIREARM_ONNX_MODEL_PATH=
# Calibrated holdout: 0.65 (bbox IoU protocol). Do not lower solely for screenshots.
FIREARM_ONNX_CONF=0.65
FIREARM_ONNX_IOU=0.45
FIREARM_ONNX_IMGSZ=640

# Custom Firearm YOLOX V3 (Apache-2.0) — research / #/dev/cv-test only.
# Keep false on DemoPage livestream. Start-LocalDemo: -EnableYoloxHarness.
FIREARM_YOLOX_ENABLED=false
# FIREARM_YOLOX_CACHE_DIR=C:\Users\YOU\.cache\smart-livestream-firearm-yolox\artifacts
# Prefer V3: ...\artifacts\v3_train\gun_yolox_nano.onnx
# FIREARM_YOLOX_MODEL_PATH=
# YOLOX score scale ≠ Subh775; corrected-GT best-F1 thr ≈ 0.02 (not 0.65)
FIREARM_YOLOX_CONF=0.02
FIREARM_YOLOX_IOU=0.45
FIREARM_YOLOX_IMGSZ=416
# Persist gun-hit frames under .local/cv-evidence/ (gitignored)
FIREARM_EVIDENCE_CAPTURE=true

# Livestream comment spam guard (in-memory, per backend replica):
COMMENT_SPAM_GUARD_ENABLED=true
COMMENT_RATE_LIMIT_COUNT=5
COMMENT_RATE_LIMIT_WINDOW_SECONDS=10
COMMENT_DUPLICATE_STREAK_LIMIT=3
COMMENT_VIOLATION_WINDOW_SECONDS=60
COMMENT_VIOLATIONS_BEFORE_BLOCK=2
COMMENT_BLOCK_SECONDS=120
COMMENT_SPAM_STATE_MAX_VIEWERS=5000
