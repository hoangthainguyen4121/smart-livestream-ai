# Copy to `.env.local` for local dev (see frontend/.env.local).
# Railway/cloud: keep vision recognition disabled unless backend has optional CLIP deps.

VITE_API_BASE_URL=http://127.0.0.1:8000
VITE_ENABLE_CAMERA_PRODUCT_RECOGNITION=false

# Sharp-object live termination (COCO knife/scissors evidence; not violence/18+)
VITE_SHARP_OBJECT_MIN_CONFIDENCE=0.70
VITE_SHARP_OBJECT_REQUIRED_HITS=3
VITE_SHARP_OBJECT_WINDOW_MS=5000

# Adult/NSFW frame-gate UI (backend NSFW_FRAME_GATE_ENABLED must also be true)
# Warning only — does not auto-close the live session in this slice.
VITE_NSFW_FRAME_GATE_ENABLED=false
VITE_NSFW_MIN_SCORE=0.70
VITE_NSFW_REQUIRED_HITS=2
VITE_NSFW_WINDOW_MS=5000
VITE_NSFW_INFERENCE_INTERVAL_MS=1000

# Weapon/gun frame-gate UI (backend WEAPON_DETECTOR_ENABLED must also be true)
# Host-only Grounding DINO via local backend — warning only, ~1 FPS, drop-if-busy.
VITE_WEAPON_DETECTOR_ENABLED=false
VITE_WEAPON_MIN_SCORE=0.42
VITE_WEAPON_REQUIRED_HITS=2
VITE_WEAPON_WINDOW_MS=35000
# CPU Grounding DINO ~8–12s/frame locally — start slower than 1s.
VITE_WEAPON_INFERENCE_INTERVAL_MS=10000
# Keep false for MVP — confirmed_risk is warning UI only.
VITE_WEAPON_AUTO_TERMINATE=false

# Firearm ONNX (Subh775 → onnxruntime). LOCAL/THESIS ONLY — default false for production.
# Start-LocalDemo.ps1 sets true in the Vite child process. AGPL lineage — not production-ready.
# When true + backend FIREARM_ONNX_ENABLED + onnx file present → DemoPage uses ONNX @ 2 FPS.
# Otherwise falls back to Grounding DINO if VITE_WEAPON_DETECTOR_ENABLED=true.
VITE_FIREARM_YOLOX_ENABLED=false
VITE_FIREARM_ONNX_ENABLED=false

# Hand-held product vision (MediaPipe Hands + backend visual embeddings).
# Requires backend HAND_HELD_VISION_ENABLED=true and optional pip install -r requirements-vision.txt
VITE_ENABLE_HAND_HELD_VISION=false

# Optional login with Supabase Auth + Google OAuth.
# Google Client ID/Secret: configure in Supabase Dashboard → Authentication → Providers → Google.
# Leave these empty to keep guest-only chat.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-public-key
