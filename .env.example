# Browser-facing API URL (must be reachable from your host browser, not the Docker service name).
VITE_API_BASE_URL=http://127.0.0.1:8000
# Optional comma-separated STUN URLs for WebRTC ICE (local/LAN demo). No TURN in this MVP.
# VITE_WEBRTC_STUN_URLS=stun:stun.l.google.com:19302

# Sharp-object live termination (COCO knife/scissors evidence; not violence/18+)
VITE_SHARP_OBJECT_MIN_CONFIDENCE=0.70
VITE_SHARP_OBJECT_REQUIRED_HITS=3
VITE_SHARP_OBJECT_WINDOW_MS=5000

# Adult/NSFW frame-gate (Falconsai ViT — local backend only, warning only, no auto-close)
# Weights MUST stay outside this repo (never commit HF cache).
VITE_NSFW_FRAME_GATE_ENABLED=false
VITE_ADULT_MODERATION_ENABLED=false
NSFW_FRAME_GATE_ENABLED=false
NSFW_MODEL_ID=Falconsai/nsfw_image_detection
NSFW_MODEL_REVISION=04367978d3474804ab1a00a9bd6548b741764069
# Example Windows: NSFW_MODEL_CACHE_DIR=C:\Users\YOU\.cache\smart-livestream-nsfw
# NSFW_MODEL_CACHE_DIR=
NSFW_MIN_SCORE=0.70
VITE_NSFW_MIN_SCORE=0.70
VITE_NSFW_REQUIRED_HITS=2
VITE_NSFW_WINDOW_MS=5000
VITE_NSFW_INFERENCE_INTERVAL_MS=1000
# Suggestive classifier (viddexa nano) — Start-LocalDemo forces on locally.
SUGGESTIVE_CLASSIFIER_ENABLED=false
# SUGGESTIVE_MODEL_CACHE_DIR=C:\Users\YOU\.cache\smart-livestream-suggestive
VITE_ADULT_REQUIRED_HITS=2
VITE_ADULT_WINDOW_MS=5000
VITE_ADULT_INFERENCE_INTERVAL_MS=1500

# Weapon/gun open-vocab detector (Grounding DINO tiny — local backend, warning only)
VITE_WEAPON_DETECTOR_ENABLED=false
WEAPON_DETECTOR_ENABLED=false
WEAPON_MODEL_ID=IDEA-Research/grounding-dino-tiny
WEAPON_MODEL_REVISION=a2bb814dd30d776dcf7e30523b00659f4f141c71
# Example Windows: WEAPON_MODEL_CACHE_DIR=C:\Users\YOU\.cache\smart-livestream-weapon
# WEAPON_MODEL_CACHE_DIR=
VITE_WEAPON_MIN_SCORE=0.42
VITE_WEAPON_REQUIRED_HITS=2
VITE_WEAPON_WINDOW_MS=35000
VITE_WEAPON_INFERENCE_INTERVAL_MS=10000
VITE_WEAPON_AUTO_TERMINATE=false

# Firearm detectors — production/Railway default: all false.
# Local MVP (Start-LocalDemo.ps1 child env): Subh775 ONNX ON; Custom YOLOX OFF
# unless -EnableYoloxHarness (research / #/dev/cv-test only).
# Selection order when enabled: Subh775 → optional YOLOX → Grounding DINO.
VITE_FIREARM_ONNX_ENABLED=false
FIREARM_ONNX_ENABLED=false
# FIREARM_ONNX_CACHE_DIR=C:\Users\YOU\.cache\smart-livestream-firearm-onnx
VITE_FIREARM_YOLOX_ENABLED=false
# FIREARM_YOLOX_ENABLED=false

# Comma-separated frontend origins allowed by backend CORS.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080,http://127.0.0.1:8080

# Camera product recognition (catalog-scoped, lightweight, frontend-only). Default false on cloud.
VITE_ENABLE_CAMERA_PRODUCT_RECOGNITION=false
CAMERA_PRODUCT_RECOGNITION_ENABLED=false

# --- Optional: PhoBERT intent ML service (smart-livestream-ml repo, NOT in this compose) ---
# Start separately: python scripts/serve_intent_api.py --model-dir ../smart-livestream-ml/artifacts/phobert_base_combined_hardcases_v3 --port 8010
# Fallback: ../smart-livestream-ml/artifacts/phobert_base_combined_hardcases_v2
# Docker backend defaults to host.docker.internal so a host-run ML API is reachable.
ML_INTENT_API_URL=http://127.0.0.1:8010
ML_INTENT_TIMEOUT_SECONDS=2

# --- Chat persistence (P0c) ---
# memory = default hot path, no PostgreSQL required
# short_retention = durable ops log + history API (requires DATABASE_URL)
CHAT_PERSISTENCE_MODE=memory
CHAT_RETENTION_HOURS=24
COMMENT_PERSIST_TIMEOUT_SECONDS=3.0
# Feedback DB for intent corrections/admin/export (optional when chat stays memory):
# docker compose -f docker-compose.postgres.yml up -d
# DATABASE_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:5432/smart_livestream_local
# ADMIN_API_KEY=local-dev-admin-key

# Livestream comment spam guard (in-memory, per backend replica):
COMMENT_SPAM_GUARD_ENABLED=true
COMMENT_RATE_LIMIT_COUNT=5
COMMENT_RATE_LIMIT_WINDOW_SECONDS=10
COMMENT_DUPLICATE_STREAK_LIMIT=3
COMMENT_VIOLATION_WINDOW_SECONDS=60
COMMENT_VIOLATIONS_BEFORE_BLOCK=2
COMMENT_BLOCK_SECONDS=120
COMMENT_SPAM_STATE_MAX_VIEWERS=5000
